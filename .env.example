# ─────────────────────────────────────────────────────────────
#  Thailand Election System — Environment Variables
#  Copy to .env and fill in values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_ENV=development
SERVER_PORT=8080
SERVER_TIMEOUT=30s

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=election_db
POSTGRES_USER=election_user
POSTGRES_PASSWORD=change_me_election_pass
DATABASE_URL=postgres://election_user:change_me_election_pass@postgres:5432/election_db?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ── Redis — Persistent (leaderboards, locks, OTP) ─────────────
REDIS_PERSISTENT_PASSWORD=change_me_redis_persist
REDIS_PERSISTENT_URL=redis://:change_me_redis_persist@redis-persistent:6379/0

# ── Redis — Cache (rate limiting, province cache) ─────────────
REDIS_CACHE_PASSWORD=change_me_redis_cache
REDIS_CACHE_URL=redis://:change_me_redis_cache@redis-cache:6379/0

# ── Redis — asynq (job queues) ────────────────────────────────
REDIS_ASYNQ_PASSWORD=change_me_redis_asynq
REDIS_ASYNQ_URL=redis://:change_me_redis_asynq@redis-asynq:6379/0

# ── Kafka (Redpanda in dev) ───────────────────────────────────
KAFKA_BROKERS=redpanda:9092

# ── JWT RS256 ─────────────────────────────────────────────────
# Generate with: make generate-keys
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_VOTER_TTL=30m
JWT_ADMIN_TTL=15m

# ── Centrifugo ────────────────────────────────────────────────
CENTRIFUGO_API_ENDPOINT=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=change_me_centrifugo_api_key
CENTRIFUGO_TOKEN_SECRET=change_me_centrifugo_token_secret
CENTRIFUGO_ADMIN_PASSWORD=change_me_centrifugo_admin
CENTRIFUGO_ADMIN_SECRET=change_me_centrifugo_admin_secret

# ── DOPA API ──────────────────────────────────────────────────
# In dev: points to dopa-mock container
# In prod: points to real DOPA government API
DOPA_API_URL=http://dopa-mock:9090
DOPA_TIMEOUT=5s

# ── Security ──────────────────────────────────────────────────
# Pepper for national_id hashing (NEVER log or expose)
# Generate with: openssl rand -hex 32
NATIONAL_ID_PEPPER=change_me_national_id_pepper_32bytes

# Key for encrypting phone numbers at rest
# Generate with: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=change_me_phone_encryption_key_32b

# ── OTP Dev Mode ──────────────────────────────────────────────
# true = OTP returned in API response for browser display
# false = OTP sent via SMS (production)
OTP_DEV_MODE=true

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Simulator Ed25519 signing key ─────────────────────────────
# Base64-encoded raw Ed25519 private key (64 bytes).
# Corresponds to the public key seeded into province_keys by make seed.
# Generate with: make generate-sim-key
SIMULATOR_ED25519_PRIVATE_KEY=

# ── Frontend ──────────────────────────────────────────────────
# Browser-facing URL (through nginx → Kong)
NEXT_PUBLIC_API_URL=http://localhost:80/api/v1
NEXT_PUBLIC_CENTRIFUGO_URL=ws://localhost:8001/connection/websocket

# Internal URL used by Next.js Server Components (Docker network, no CORS check)
API_INTERNAL_URL=http://api:8080/api/v1
